modules = ["python-3.12", "nodejs-20", "web", "bash", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow]]
name = "Backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start_backend.sh"
waitForPort = 8000

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5099
externalPort = 3002

[[ports]]
localPort = 6379
externalPort = 3001

[[ports]]
localPort = 8000
externalPort = 8000

[userenv]

[userenv.shared]
S3_BUCKET = "clawith-main"
S3_ENDPOINT_URL = "https://storage.googleapis.com"
STORAGE_BACKEND = "replit"
STORAGE_LOCAL_ROOT = "/home/runner/workspace/.data/agents"
AGENT_DATA_DIR = "/home/runner/workspace/.data/agents"
REPLIT_OBJECT_STORAGE_BUCKET_ID = "replit-objstore-a204e669-53ec-450f-b516-bb443fc4ba91"
REPLIT_OBJECT_STORAGE_PREFIX = "agents"
DOCKER_ENABLED = "false"

[objectStorage]
defaultBucketID = "replit-objstore-5498ecab-1741-4522-9a72-349f8319ca5a"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "vm"
run = ["bash", "start_production.sh"]
build = ["bash", "-c", "cd frontend && npm run build && cd ../backend && (.venv/bin/python -m compileall -q -j 0 app .venv/lib/python3.12/site-packages || true)"]
